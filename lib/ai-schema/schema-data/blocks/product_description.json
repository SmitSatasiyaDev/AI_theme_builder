{
    "id": "product_description",
    "label": "Product Description",
    "purpose": "Display full product description with formatting options",
    "category": "product-detail",
    "tags": [],
    "settings": {
        "show_full_description": {
            "type": "checkbox",
            "default": true
        },
        "show_read_more": {
            "type": "checkbox",
            "default": false
        },
        "truncate_length": {
            "type": "range",
            "min": 100,
            "max": 500,
            "default": 200
        },
        "text_alignment": [
            "left",
            "center",
            "right"
        ],
        "style": [
            "body",
            "subtitle",
            "caption"
        ]
    },
    "_notes": "Shows product description from Shopify admin. Can truncate with 'Read more' button. Supports HTML formatting. Essential for SEO and explaining product features/benefits."
}
