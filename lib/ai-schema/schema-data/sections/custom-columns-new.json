    "settings": {
        "visibility": [
            "desktop-hidden",
            "mobile-hidden",
            "always-display"
        ],
        "color_scheme": [
            "accent-1",
            "accent-2",
            "background-1",
            "background-2",
            "inverse",
            "custom"
        ],
        "desktop_page_width": [
            "page-width--narrow",
            "normal",
            "desktop-full-page",
            "desktop-full-page-no-padding",
