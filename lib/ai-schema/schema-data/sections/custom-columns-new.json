        ],
        "column_gap_desktop": {
            "type": "range",
            "min": 0,
            "max": 100,
            "unit": "px",
            "default": 40
        },
        "row_gap_desktop": {
            "type": "range",
            "min": 0,
            "max": 100,
            "unit": "px",
            "default": 40
        },
        "desktop_vertical_alignment": [
            "flex-start",
            "center",
            "flex-end"
        ]
    },
    "allowed_blocks": [
        "column"
    ],
    "_notes": "Newer variant of the existing 'custom-columns' section (real Liquid file custom-columns-new.liquid, distinct from custom-columns.liquid) — same layout-container idea, different real settings/defaults, so kept as a separate schema rather than merged."
