{
  "name": "ai-schema-saas",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "next dev",
    "dev:all": "concurrently -n next,worker -c blue,magenta \"pnpm:dev\" \"pnpm:worker\"",
    "build": "next build",
    "start": "next start",
    "worker": "tsx watch scripts/worker.ts",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:local": "tsx scripts/db-local.ts",
    "generate": "tsx scripts/generate-cli.ts",
    "theme:dev": "shopify theme dev --path theme_base/theme",
    "theme:check": "shopify theme check --path theme_base/theme"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@base-ui/react": "^1.7.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "liquidjs": "^10.29.0",
    "next": "16.3.1",
    "next-auth": "^5.0.0-beta.32",
    "pg-boss": "^12.27.0",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "swr": "^2.5.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
