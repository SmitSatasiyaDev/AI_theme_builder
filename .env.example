# Postgres connection string (Neon, Supabase, RDS, local, etc.)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=""

# Optional Google OAuth (credentials/email+password always works without this)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 32+ char secret used to derive the AES-256-GCM key for encrypting stored
# Shopify access tokens at rest (lib/crypto.ts). Do not reuse AUTH_SECRET.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=""

# Shopify Partner app (Phase 2 — OAuth install/callback).
# NOTE: read_themes/write_themes are deliberately NOT requested. This app's
# custom-app token can't get merchant approval for them (that is the whole
# reason lib/ai-schema/local-theme-fs.ts writes to LOCAL_THEME_ROOT on disk
# instead of the live theme). Asking for them here only breaks the install
# screen. Re-add them if and when they are actually approved.
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SHOPIFY_APP_URL="http://localhost:3000"
SHOPIFY_SCOPES="read_products"

# Local theme checkout that generation/apply read and write instead of the
# live store's theme (lib/ai-schema/local-theme-fs.js) — avoids needing
# merchant-approved read_themes/write_themes on the custom app. Must point
# at a full theme checkout (templates/, config/, sections/, blocks/, ...).
# REQUIRED — there is no fallback. Must live in .env, NOT .env.local:
# scripts/worker.ts loads env via process.loadEnvFile(), which reads .env only.
LOCAL_THEME_ROOT="/absolute/path/to/AI_theme_builder/theme_base/theme"

# OpenRouter (used by the ported ai-schema generation pipeline, Phase 3)
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="moonshotai/kimi-k2.5"

# Fast/cheap model used only for brief-intake's per-chat-turn field
# extraction (lib/ai-schema/brief-intake.ts) — a simple structured-extraction
# task, kept off the primary OPENROUTER_MODEL to cut per-turn latency.
# Never used for Stage 1/2 staged generation (lib/ai-schema/generation.ts),
# which needs the primary model's reasoning. No hardcoded default — leave
# unset to fall back to OPENROUTER_MODEL (no fast tier). Set explicitly per
# environment, e.g. only in production.
OPENROUTER_FAST_MODEL=""
